<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/P8_TextoEstadoValor2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:background="#FFC107"
        android:text="Pendiente"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/P8_ImagenCita2"
        app:layout_constraintTop_toBottomOf="@+id/P8_TextoEstado2" />

    <TextView
        android:id="@+id/P8_TextoServicio2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="160dp"
        android:text="Corte de pelo"
        android:textColor="#3F51B5"
        app:layout_constraintStart_toEndOf="@+id/P8_ImagenCita2"
        app:layout_constraintTop_toBottomOf="@+id/P8_TextoEstadoValor1" />

    <Button
        android:id="@+id/P8_BotonDetalles2"
        android:layout_width="143dp"
        android:layout_height="49dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FFFFFF"
        android:text="Ver detalles"
        android:textColor="#03A9F4"
        android:textColorLink="#03A9F4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P8_ImagenCita2"
        app:strokeColor="#03A9F4"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/P8_BotonCancelar1"
        android:layout_width="143dp"
        android:layout_height="49dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FFFFFF"
        android:text="Cancelar"
        android:textColor="#F44336"
        android:textColorLink="#F44336"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P8_BotonDetalles1"
        app:strokeColor="#F44336"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/P8_BotonCancelar2"
        android:layout_width="143dp"
        android:layout_height="49dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FFFFFF"
        android:text="Cancelar"
        android:textColor="#F44336"
        android:textColorLink="#F44336"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P8_BotonDetalles2"
        app:strokeColor="#F44336"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/P8_BotonDetalles1"
        android:layout_width="143dp"
        android:layout_height="49dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FFFFFF"
        android:text="Ver detalles"
        android:textColor="#03A9F4"
        android:textColorLink="#03A9F4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P8_ImagenCita1"
        app:strokeColor="#03A9F4"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/P8_BotonInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#FFFFFF"
        android:text="Volver a inicio"
        android:textColor="#03A9F4"
        android:textColorLink="#03A9F4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.927"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#03A9F4"
        app:strokeWidth="2dp" />

    <ImageButton
        android:id="@+id/P8_BotonVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="#03A9F4"
        app:layout_constraintEnd_toStartOf="@+id/logoAppP8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_menu_revert" />

    <ImageView
        android:id="@+id/logoAppP8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/citafacillogo" />

    <TextView
        android:id="@+id/P8_TextoTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:text="Mis citas"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P8_BotonVolver" />

    <ImageView
        android:id="@+id/P8_ImagenCita1"
        android:layout_width="172dp"
        android:layout_height="114dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P8_TextoTitulo"
        app:srcCompat="@drawable/logo_negocio_pelu" />

    <ImageView
        android:id="@+id/P8_ImagenCita2"
        android:layout_width="171dp"
        android:layout_height="163dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P8_BotonCancelar1"
        app:srcCompat="@drawable/foto_negocio" />

    <TextView
        android:id="@+id/P8_TextoServicio1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="56dp"
        android:text="Tratamiento facial"
        android:textColor="#3F51B5"
        app:layout_constraintStart_toEndOf="@+id/P8_ImagenCita1"
        app:layout_constraintTop_toBottomOf="@+id/logoAppP8" />

    <TextView
        android:id="@+id/P8_TextoEstado1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"
        android:text="Estado"
        app:layout_constraintStart_toEndOf="@+id/P8_ImagenCita1"
        app:layout_constraintTop_toBottomOf="@+id/P8_TextoServicio1" />

    <TextView
        android:id="@+id/P8_TextoEstado2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"
        android:text="Estado"
        app:layout_constraintStart_toEndOf="@+id/P8_ImagenCita2"
        app:layout_constraintTop_toBottomOf="@+id/P8_TextoServicio2" />

    <TextView
        android:id="@+id/P8_TextoEstadoValor1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:background="#4CAF50"
        android:text="Confirmado"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/P8_ImagenCita1"
        app:layout_constraintTop_toBottomOf="@+id/P8_TextoEstado1" />

</androidx.constraintlayout.widget.ConstraintLayout>