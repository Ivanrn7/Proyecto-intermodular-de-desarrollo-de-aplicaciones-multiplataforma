<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/PPerfil_BotonEliminarCuenta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#00FFFFFF"
        android:text="Eliminar cuenta"
        android:textColor="#F44336"
        android:textColorLink="#F44336"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.521"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/PPerfil_BotonCerrarSesion" />

    <Button
        android:id="@+id/PPerfil_BotonCerrarSesion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="#00FFFFFF"
        android:text="Cerrar sesion"
        android:textColor="#3F51B5"
        android:textColorLink="#3F51B5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/PPerfil_BotonMetodosPago" />

    <Button
        android:id="@+id/PPerfil_BotonMetodosPago"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#E7E7E7"
        android:text="Metodos de pago"
        android:textColor="#03A9F4"
        android:textColorLink="#03A9F4"
        app:layout_constraintStart_toEndOf="@+id/PPerfil_IconoMetodosPago"
        app:layout_constraintTop_toBottomOf="@+id/PPerfil_BotonNotificaciones"
        app:strokeColor="#03A9F4"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/PPerfil_BotonNotificaciones"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#E7E7E7"
        android:text="Notificaciones"
        android:textColor="#03A9F4"
        android:textColorLink="#03A9F4"
        app:layout_constraintStart_toEndOf="@+id/PPerfil_IconoNotificaciones"
        app:layout_constraintTop_toBottomOf="@+id/PPerfil_BotonDatosPersonales"
        app:strokeColor="#03A9F4"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/PPerfil_BotonDatosPersonales"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#E7E7E7"
        android:text="Datos personales"
        android:textColor="#03A9F4"
        android:textColorLink="#03A9F4"
        app:layout_constraintStart_toEndOf="@+id/PPerfil_IconoUsuario"
        app:layout_constraintTop_toBottomOf="@+id/PPerfil_TextoUsuario"
        app:strokeColor="#03A9F4"
        app:strokeWidth="2dp" />

    <TextView
        android:id="@+id/PPerfil_Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="16dp"
        android:text="Perfil"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoAppPPerfil" />

    <ImageButton
        android:id="@+id/PPerfil_BotonAtras"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="#03A9F4"
        app:layout_constraintEnd_toStartOf="@+id/logoAppPPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_menu_revert" />

    <ImageView
        android:id="@+id/logoAppPPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/citafacillogo" />

    <ImageView
        android:id="@+id/PPerfil_ImagenPerfil"
        android:layout_width="135dp"
        android:layout_height="133dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/PPerfil_Titulo"
        app:srcCompat="@drawable/imagen_perfil" />

    <TextView
        android:id="@+id/PPerfil_TextoUsuario"
        android:layout_width="121dp"
        android:layout_height="23dp"
        android:layout_marginTop="16dp"
        android:background="#009688"
        android:text="NombreUsuario"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/PPerfil_ImagenPerfil" />

    <ImageView
        android:id="@+id/PPerfil_IconoUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/PPerfil_TextoUsuario"
        app:srcCompat="@drawable/icono_usuario" />

    <ImageView
        android:id="@+id/PPerfil_IconoNotificaciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/PPerfil_IconoUsuario"
        app:srcCompat="@drawable/campana_notif" />

    <ImageView
        android:id="@+id/PPerfil_IconoMetodosPago"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/PPerfil_IconoNotificaciones"
        app:srcCompat="@drawable/icono_metodospago" />

</androidx.constraintlayout.widget.ConstraintLayout>