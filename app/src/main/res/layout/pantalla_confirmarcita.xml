<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- CONTENIDO DESPLAZABLE -->
    <ScrollView
        android:id="@+id/P6_ScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/P6_ContenedorBotones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- CABECERA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/P6_BotonAtras"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:backgroundTint="#03A9F4"
                    android:contentDescription="Volver atrás"
                    app:srcCompat="@android:drawable/ic_menu_revert" />

                <ImageView
                    android:id="@+id/logoAppP2"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:contentDescription="Logo CitaFácil"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/citafacillogo" />

            </LinearLayout>

            <!-- BANNER DEL NEGOCIO -->
            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="10dp"
                android:scaleType="centerCrop"
                android:contentDescription="Bella Estilo Peluquería"
                app:srcCompat="@drawable/logo_peluqueria" />

            <!-- TITULO -->
            <TextView
                android:id="@+id/textView13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="Tratamiento facial"
                android:textColor="#172554"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- FOTOGRAFIA DEL TRATAMIENTO -->

            <!-- TARJETA SERVICIO -->
            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="match_parent"
                android:layout_height="207dp"
                android:contentDescription="Imagen del tratamiento facial"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/imagen_tratamiento" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="62dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@drawable/bg_cita_card">

                <ImageView
                    android:id="@+id/imageView5"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Servicio"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/icono_servicio" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView14"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Servicio"
                        android:textColor="#172554"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView18"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="aqui va el tratamiento"
                        android:textColor="#475569"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TARJETA FECHA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="62dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@drawable/bg_cita_card">

                <ImageView
                    android:id="@+id/imageView6"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Fecha"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/calendar_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView19"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fecha"
                        android:textColor="#172554"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView20"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="aqui va la fecha"
                        android:textColor="#475569"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TARJETA HORA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="62dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@drawable/bg_cita_card">

                <ImageView
                    android:id="@+id/imageView7"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Hora"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/icono_reloj" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView21"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hora"
                        android:textColor="#172554"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView22"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="aqui va la hora"
                        android:textColor="#475569"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TARJETA PRECIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="62dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@drawable/bg_cita_card">

                <ImageView
                    android:id="@+id/imageView8"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Precio"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/icono_precio" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView23"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Precio"
                        android:textColor="#172554"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView24"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="aqui va el precio"
                        android:textColor="#475569"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TARJETA LOCALIZACION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="62dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@drawable/bg_cita_card">

                <ImageView
                    android:id="@+id/imageView9"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Localización"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/location_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView25"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Localización"
                        android:textColor="#172554"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView26"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="aqui va la localizacion"
                        android:textColor="#475569"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


    <!-- BOTONES INFERIORES -->

    <LinearLayout
        android:id="@+id/P6_ContenedorBotones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="10dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CONFIRMAR CITA -->
        <Button
            android:id="@+id/P6_BotonConfirmar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="30dp"
            android:background="@drawable/bg_boton_confirmar"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="Confirmar cita"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="normal"
            android:textAllCaps="false"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>

        <!-- VOLVER A BUSCAR -->
        <Button
            android:id="@+id/P6_BotonVolver"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_boton_volver"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="Volver a buscar"
            android:textColor="#5146F5"
            android:textSize="14sp"
            android:textStyle="normal"
            android:textAllCaps="false"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
