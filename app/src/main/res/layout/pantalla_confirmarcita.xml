<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/P6_BotonVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#FFFFFF"
        android:text="Volver a buscar"
        android:textColor="#03A9F4"
        android:textColorLink="#03A9F4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#03A9F4"
        app:strokeWidth="2dp" />

    <Button
        android:id="@+id/P6_BotonConfirmar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#03A9F4"
        android:text="Confirmar cita"
        android:textColorLink="#03A9F4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/P6_TextoLocalizacionValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="aqui va la localizacion"
        android:textColor="#3F51B5"
        app:layout_constraintStart_toEndOf="@+id/P6_IconoLocalizacion"
        app:layout_constraintTop_toBottomOf="@+id/P6_TextoLocalizacion" />

    <TextView
        android:id="@+id/P6_TextoLocalizacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="Localizacion"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/P6_IconoLocalizacion"
        app:layout_constraintTop_toBottomOf="@+id/P6_TextoPrecioValor" />

    <TextView
        android:id="@+id/P6_TextoPrecioValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="aqui va el precio"
        android:textColor="#3F51B5"
        app:layout_constraintStart_toEndOf="@+id/P6_IconoPrecio"
        app:layout_constraintTop_toBottomOf="@+id/P6_TextoPrecio" />

    <TextView
        android:id="@+id/P6_TextoPrecio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="Precio"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/P6_IconoPrecio"
        app:layout_constraintTop_toBottomOf="@+id/P6_TextoHoraValor" />

    <TextView
        android:id="@+id/P6_TextoHoraValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="aqui va la hora"
        android:textColor="#3F51B5"
        app:layout_constraintStart_toEndOf="@+id/P6_IconoHora"
        app:layout_constraintTop_toBottomOf="@+id/P6_TextoHora" />

    <TextView
        android:id="@+id/P6_TextoHora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="Hora"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/P6_IconoHora"
        app:layout_constraintTop_toBottomOf="@+id/P6_TextoFechaValor" />

    <TextView
        android:id="@+id/P6_TextoFechaValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="aqui va la fecha"
        android:textColor="#3F51B5"
        app:layout_constraintStart_toEndOf="@+id/P6_IconoFecha"
        app:layout_constraintTop_toBottomOf="@+id/P6_TextoFecha" />

    <TextView
        android:id="@+id/P6_TextoFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="Fecha"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/P6_IconoFecha"
        app:layout_constraintTop_toBottomOf="@+id/P6_TextoServicioValor" />

    <TextView
        android:id="@+id/P6_TextoServicioValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="aqui va el tratamiento"
        android:textColor="#3F51B5"
        app:layout_constraintStart_toEndOf="@+id/P6_IconoServicio"
        app:layout_constraintTop_toBottomOf="@+id/P6_TextoServicio" />

    <ImageView
        android:id="@+id/P6_ImagenNegocio"
        android:layout_width="430dp"
        android:layout_height="138dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.526"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoAppP6"
        app:srcCompat="@drawable/logo_peluqueria" />

    <ImageButton
        android:id="@+id/P6_BotonAtras"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="#03A9F4"
        app:layout_constraintEnd_toStartOf="@+id/logoAppP6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_menu_revert" />

    <ImageView
        android:id="@+id/logoAppP6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/citafacillogo" />

    <TextView
        android:id="@+id/P6_TextoNombreServicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tratamiento facial"
        android:textColor="#3F51B5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P6_ImagenNegocio" />

    <ImageView
        android:id="@+id/P6_ImagenServicio"
        android:layout_width="204dp"
        android:layout_height="147dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P6_TextoNombreServicio"
        app:srcCompat="@drawable/imagen_tratamiento" />

    <TextView
        android:id="@+id/P6_TextoServicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="Servicio"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/P6_IconoServicio"
        app:layout_constraintTop_toBottomOf="@+id/P6_ImagenServicio" />

    <ImageView
        android:id="@+id/P6_IconoServicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P6_ImagenServicio"
        app:srcCompat="@drawable/icono_servicio" />

    <ImageView
        android:id="@+id/P6_IconoFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P6_IconoServicio"
        app:srcCompat="@drawable/calendar_icon" />

    <ImageView
        android:id="@+id/P6_IconoHora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P6_IconoFecha"
        app:srcCompat="@drawable/icono_reloj" />

    <ImageView
        android:id="@+id/P6_IconoPrecio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P6_IconoHora"
        app:srcCompat="@drawable/icono_precio" />

    <ImageView
        android:id="@+id/P6_IconoLocalizacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/P6_IconoPrecio"
        app:srcCompat="@drawable/location_icon" />

</androidx.constraintlayout.widget.ConstraintLayout>